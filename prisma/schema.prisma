// SupplyBase — B2B Wholesale CRM & Supplier Management Platform

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPLIER
  BUYER
  FREELANCER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier   Supplier?
  buyer      Buyer?
  freelancer Freelancer?

  ownedSupplyChains       SupplyChain[]          @relation("SupplyChainOwner")
  buyerSupplyChains       SupplyChain[]          @relation("SupplyChainBuyer")
  supplierSupplyChains    SupplyChain[]          @relation("SupplyChainSupplier")
  milestoneParticipations MilestoneParticipant[]
  uploadedMedia           MilestoneMedia[]
  uploadedAttachments     MilestoneAttachment[]
  milestoneComments       MilestoneComment[]
  milestoneActivities     MilestoneActivity[]
  sharesReceived          SupplyChainShare[]     @relation("SharedWithUser")
  sharesGiven             SupplyChainShare[]     @relation("SharedByUser")
  notifications           Notification[]

  assignedProjects  Project[]        @relation("ProjectFreelancer")
  createdProjects   Project[]        @relation("ProjectCreatedBy")
  receivedProposals Proposal[]       @relation("ProposalFreelancer")
  sentProposals     Proposal[]       @relation("ProposalCreatedBy")
  assignedTasks     FreelancerTask[] @relation("TaskFreelancer")

  contentItems     ContentItem[]
  catalogs         Catalog[]
  purchaseInvoices PurchaseInvoice[]
  salesInvoices    SalesInvoice[]

  @@index([email])
}

model Supplier {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  city        String?
  country     String?
  description String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Buyer {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  city        String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Standalone supplier directory listing — not tied to auth
model SupplierListing {
  id              String   @id @default(cuid())
  companyName     String
  description     String   @default("")
  industry        String
  supplierType    String
  country         String
  city            String
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)
  products        String[]
  responseTime    String?
  minimumOrder    String?
  phone           String?
  email           String?
  website         String?
  whatsapp        String?
  linkedin        String?
  initials        String   @default("")
  logoColor       String   @default("#6366F1")
  yearEstablished Int?
  employees       String?
  notes           String?
  savedCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogProducts Product[]
  conversation    Conversation?

  @@index([country])
  @@index([industry])
  @@index([verified])
}

// Global Product catalog for the Shop page
model Product {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  moq            String?
  priceRange     String?
  category       String?
  material       String?
  specifications String?
  country        String?
  leadTime       String?
  images         String[]
  savedCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
  @@index([country])
}

// Auto-incrementing sequence for SB-XXXXXX supplier IDs
model SupplierIdSequence {
  id Int @id @default(autoincrement())
}

// Supplier self-onboarding portal
model SupplierPortal {
  id           String  @id @default(cuid())
  supplierCode String? @unique // SB-000001
  status       String  @default("draft") // draft | submitted | approved

  // Step 1 — Business Info
  companyName  String?
  businessType String?
  industry     String?
  gst          String?
  country      String?
  state        String?
  city         String?
  website      String?
  linkedin     String?
  instagram    String?
  whatsapp     String?
  contactName  String?
  email        String?
  phone        String?

  // Profile extras
  logoUrl     String?
  coverUrl    String?
  description String?

  // Step 2 — Categories (stored as array)
  categories String[]

  // Step 3 — Products
  products PortalProduct[]

  // Step 4 — Documents
  documents PortalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierCode])
}

model PortalProduct {
  id          String         @id @default(cuid())
  portalId    String
  portal      SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name        String
  category    String
  moq         String?
  priceRange  String?
  description String?
  images      String[]
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([portalId])
}

model PortalDocument {
  id        String         @id @default(cuid())
  portalId  String
  portal    SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  docType   String // logo | cover | license | gst | catalog | certificate
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime       @default(now())

  @@index([portalId])
}

// CRM Models for WhatsApp Module
model Conversation {
  id            String          @id @default(cuid())
  supplierId    String          @unique
  supplier      SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unreadCount   Int             @default(0)
  pinned        Boolean         @default(false)
  archived      Boolean         @default(false)
  assigned      Boolean         @default(false)
  highPriority  Boolean         @default(false)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages   Message[]
  notes      CrmNote[]
  tasks      Task[]
  activities Activity[]

  @@index([supplierId])
  @@index([lastMessageAt])
}

enum MessageType {
  TEXT
  IMAGE
  PDF
  PRODUCT
  QUOTATION
  VOICE
  LOCATION
  SUPPLY_CHAIN
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // 'user' or 'supplier'
  type           MessageType  @default(TEXT)
  content        String?
  attachmentUrl  String?
  productId      String?
  supplyChainId  String?
  supplyChain    SupplyChain? @relation(fields: [supplyChainId], references: [id], onDelete: SetNull)
  status         String       @default("sent") // sent, delivered, seen
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([supplyChainId])
}

model CrmNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  author         String       @default("Me")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model Task {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  dueDate        DateTime?
  priority       String       @default("Medium") // Low, Medium, High
  assignedTo     String       @default("Me")
  completed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model Activity {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String       @default("System") // Message, Quote, Call, Meeting, System
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Supply Chain — collaborative order-lifecycle workspace (Buyer + Supplier
// portals). Real, DB-backed — no mock data. Permissions are resolved from
// ownerId + SupplyChainShare rows (see lib/supply-chain-permissions.ts).
// ---------------------------------------------------------------------------

enum SupplyChainStatus {
  ACTIVE
  DELAYED
  COMPLETED
  IN_PROGRESS
}

enum SupplyChainPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  DELAYED
}

enum BoardColumn {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum ParticipantKind {
  ASSIGNEE
  TAG
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ShareRole {
  TEAM_EDIT
  TEAM_VIEW
  BUYER_VIEW
  BUYER_COMMENT
  SUPPLIER_VIEW
  SUPPLIER_UPDATE
}

enum NotificationType {
  MILESTONE_CREATED
  ASSIGNMENT
  DUE_DATE_APPROACHING
  COMMENT_ADDED
  SUPPLY_CHAIN_SHARED
  MILESTONE_COMPLETED
  PROPOSAL_RECEIVED
  PROJECT_ASSIGNED
  ADMIN_MESSAGE
}

model SupplyChain {
  id               String              @id @default(cuid())
  name             String
  orderName        String
  orderNumber      String
  description      String?
  priority         SupplyChainPriority @default(MEDIUM)
  status           SupplyChainStatus   @default(ACTIVE)
  expectedDelivery DateTime

  ownerId String
  owner   User   @relation("SupplyChainOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  buyerUserId String?
  buyerUser   User?   @relation("SupplyChainBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerName   String

  supplierUserId String?
  supplierUser   User?   @relation("SupplyChainSupplier", fields: [supplierUserId], references: [id], onDelete: SetNull)
  supplierName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  shares     SupplyChainShare[]
  messages   Message[]

  // Optional link from a Freelancer Portal Project (see Project.supplyChainId
  // below) — purely additive, does not affect any existing Supply Chain query.
  linkedProjects Project[]

  @@index([ownerId])
  @@index([buyerUserId])
  @@index([supplierUserId])
}

model Milestone {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      MilestoneStatus     @default(NOT_STARTED)
  boardColumn BoardColumn         @default(PLANNING)
  priority    SupplyChainPriority @default(MEDIUM)
  dueDate     DateTime
  progress    Int                 @default(0)
  notes       String?
  order       Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MilestoneParticipant[]
  media        MilestoneMedia[]
  attachments  MilestoneAttachment[]
  comments     MilestoneComment[]
  activities   MilestoneActivity[]

  @@index([supplyChainId])
}

model MilestoneParticipant {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ParticipantKind
  createdAt   DateTime        @default(now())

  @@unique([milestoneId, userId, kind])
  @@index([milestoneId])
  @@index([userId])
}

model MilestoneMedia {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  kind         MediaKind
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneAttachment {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneComment {
  id              String             @id @default(cuid())
  milestoneId     String
  milestone       Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String
  parentCommentId String?
  parentComment   MilestoneComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         MilestoneComment[] @relation("CommentReplies")
  edited          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([milestoneId])
}

model MilestoneActivity {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  type        String
  description String
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([milestoneId])
}

model SupplyChainShare {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)
  role          ShareRole
  sharedById    String
  sharedBy      User        @relation("SharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([supplyChainId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ─── Freelancer Portal ──────────────────────────────────────────────────

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum FreelancerStatus {
  ACTIVE
  DEACTIVATED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum ProposalStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

enum ProposalChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Freelancer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location String?
  phone    String?
  bio      String?
  skills   String[] @default([])

  linkedinUrl  String?
  instagramUrl String?
  behanceUrl   String?
  dribbbleUrl  String?
  githubUrl    String?

  resumeFileName String?
  resumeDataUrl  String? @db.Text

  availability     FreelancerAvailability @default(AVAILABLE)
  status           FreelancerStatus       @default(ACTIVE)
  paymentStatus    PaymentStatus          @default(PENDING)
  performanceScore Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioItems FreelancerPortfolioItem[]
  experience     FreelancerExperience[]

  @@index([userId])
}

model FreelancerPortfolioItem {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  caption      String?
  dataUrl      String     @db.Text
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([freelancerId])
}

model FreelancerExperience {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  role         String
  company      String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([freelancerId])
}

model Proposal {
  id String @id @default(cuid())

  freelancerUserId String
  freelancer       User   @relation("ProposalFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  clientName  String
  description String?
  channel     ProposalChannel
  status      ProposalStatus  @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerUserId])
}

model Project {
  id String @id @default(cuid())

  name            String
  clientName      String
  startDate       DateTime
  expectedEndDate DateTime
  priority        ProjectPriority @default(MEDIUM)
  description     String?
  status          ProjectStatus   @default(UPCOMING)
  isDraft         Boolean         @default(false)

  // Section 1 — Project Details
  city           String?
  pointOfContact String?
  whatsapp       String?
  email          String?
  linkedinUrl    String?
  notes          String? @db.Text

  // Section 6 — optional link to an existing Supply Chain. SetNull so
  // deleting a chain never cascades into (or is blocked by) a Project.
  supplyChainId String?
  supplyChain   SupplyChain? @relation(fields: [supplyChainId], references: [id], onDelete: SetNull)

  freelancerUserId String
  freelancer       User   @relation("ProjectFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           FreelancerTask[]
  timeline        ProjectTimelineEntry[]
  referenceLinks  ProjectReferenceLink[]
  referenceImages ProjectReferenceImage[]
  documents       ProjectDocument[]
  items           ProjectItem[]

  @@index([freelancerUserId])
  @@index([supplyChainId])
}

enum ProjectTimelineStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model ProjectTimelineEntry {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  status      ProjectTimelineStatus @default(NOT_STARTED)
  order       Int                   @default(0)
  createdAt   DateTime              @default(now())

  @@index([projectId])
}

enum ReferenceLinkPlatform {
  WEBSITE
  INSTAGRAM
  LINKEDIN
  BEHANCE
  DRIBBBLE
  GOOGLE_DRIVE
  FIGMA
}

model ProjectReferenceLink {
  id        String                @id @default(cuid())
  projectId String
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform  ReferenceLinkPlatform @default(WEBSITE)
  url       String
  order     Int                   @default(0)
  createdAt DateTime              @default(now())

  @@index([projectId])
}

model ProjectReferenceImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  caption   String?
  dataUrl   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String   @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectItem {
  id String @id @default(cuid())

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       String
  name           String
  quantity       Int      @default(1)
  sizes          String[] @default([])
  priceBeforeGst Float    @default(0)
  priceAfterGst  Float    @default(0)
  shippingCost   Float    @default(0)
  miscCost       Float    @default(0)
  leadTime       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model FreelancerTask {
  id String @id @default(cuid())

  title    String
  dueDate  DateTime
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(NOT_STARTED)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  freelancerUserId String
  freelancer       User   @relation("TaskFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerUserId])
}

// ─── Module 1: Content Management ──────────────────────────────────────────
// Owned per-user across all four portals — real, DB-backed, no mock data.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// AI Content Studio — Phase 1. All optional/nullable since plain content
// items (created before this migration, or without going through the AI
// flow) never populate them.
enum ContentType {
  PRODUCT_DESCRIPTION
  COMPANY_PROFILE
  EMAIL
  NEWSLETTER
  LINKEDIN_POST
  INSTAGRAM_CAPTION
  WEBSITE_CONTENT
  BLOG
  CATALOG_DESCRIPTION
  OTHER
}

enum ContentLanguage {
  ENGLISH
  FRENCH
  GERMAN
}

enum ContentTone {
  PROFESSIONAL
  FRIENDLY
  LUXURY
  TECHNICAL
  MARKETING
}

enum ContentAudience {
  BUYERS
  SUPPLIERS
  EXPORTERS
  RETAILERS
  MANUFACTURERS
}

model ContentItem {
  id               String        @id @default(cuid())
  title            String
  category         String?
  tags             String[]      @default([])
  featuredImageUrl String?       @db.Text
  bodyHtml         String        @db.Text
  status           ContentStatus @default(DRAFT)

  // AI Content Studio — the prompt/config used to generate this content, and
  // whether the user has explicitly saved it as a reusable template.
  prompt      String?          @db.Text
  contentType ContentType?
  language    ContentLanguage?
  tone        ContentTone?
  audience    ContentAudience?
  isTemplate  Boolean          @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  attachments ContentAttachment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([isTemplate])
}

model ContentAttachment {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([contentId])
}

// ─── Module 2: Catalog Management ──────────────────────────────────────────
// One catalog per user (auto-created on first visit), Notion/Airtable-style
// editable rows.

model Catalog {
  id          String  @id @default(cuid())
  name        String  @default("My Catalog")
  description String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  rows CatalogRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CatalogRowStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model CatalogRow {
  id String @id @default(cuid())

  catalogId String
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  category       String?
  productName    String
  sku            String?
  description    String?
  quantity       Int              @default(0)
  sizes          String[]         @default([])
  color          String?
  moq            Int?
  priceBeforeGst Float            @default(0)
  priceAfterGst  Float            @default(0)
  currency       String           @default("INR")
  shippingCost   Float            @default(0)
  miscCost       Float            @default(0)
  leadTime       String?
  status         CatalogRowStatus @default(ACTIVE)
  notes          String?
  order          Int              @default(0)

  images      CatalogRowImage[]
  attachments CatalogRowAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
}

model CatalogRowImage {
  id      String     @id @default(cuid())
  rowId   String
  row     CatalogRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  dataUrl String     @db.Text
  order   Int        @default(0)

  @@index([rowId])
}

model CatalogRowAttachment {
  id        String     @id @default(cuid())
  rowId     String
  row       CatalogRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([rowId])
}

// ─── Module 3: Invoice Management ──────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PENDING
  OVERDUE
}

model PurchaseInvoice {
  id            String        @id @default(cuid())
  vendor        String
  poNumber      String?
  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime
  gst           Float         @default(0)
  shipping      Float         @default(0)
  totalAmount   Float         @default(0)
  status        InvoiceStatus @default(DRAFT)
  notes         String?

  attachmentFileName String?
  attachmentDataUrl  String? @db.Text

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

model SalesInvoice {
  id            String        @id @default(cuid())
  customer      String
  invoiceNumber String
  invoiceDate   DateTime
  dueDate       DateTime
  gst           Float         @default(0)
  shipping      Float         @default(0)
  grandTotal    Float         @default(0)
  paymentStatus InvoiceStatus @default(DRAFT)
  notes         String?

  attachmentFileName String?
  attachmentDataUrl  String? @db.Text

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  items SalesInvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([paymentStatus])
}

model SalesInvoiceItem {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productName String
  quantity    Int          @default(1)
  unitPrice   Float        @default(0)
  order       Int          @default(0)

  @@index([invoiceId])
}
