// SupplyBase — B2B Wholesale CRM & Supplier Management Platform

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPLIER
  BUYER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier?
  buyer    Buyer?

  @@index([email])
}

model Supplier {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  city        String?
  country     String?
  description String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Buyer {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  city        String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Standalone supplier directory listing — not tied to auth
model SupplierListing {
  id              String   @id @default(cuid())
  companyName     String
  description     String   @default("")
  industry        String
  supplierType    String
  country         String
  city            String
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)
  products        String[]
  responseTime    String?
  minimumOrder    String?
  phone           String?
  email           String?
  website         String?
  whatsapp        String?
  linkedin        String?
  initials        String   @default("")
  logoColor       String   @default("#6366F1")
  yearEstablished Int?
  employees       String?
  notes           String?
  savedCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogProducts Product[]

  @@index([country])
  @@index([industry])
  @@index([verified])
}

// Global Product catalog for the Shop page
model Product {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  name           String
  description    String?
  moq            String?
  priceRange     String?
  category       String?
  material       String?
  specifications String?
  country        String?
  leadTime       String?
  images         String[]
  savedCount     Int             @default(0)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  @@index([supplierId])
  @@index([category])
  @@index([country])
}

// Auto-incrementing sequence for SB-XXXXXX supplier IDs
model SupplierIdSequence {
  id Int @id @default(autoincrement())
}

// Supplier self-onboarding portal
model SupplierPortal {
  id           String   @id @default(cuid())
  supplierCode String?  @unique  // SB-000001
  status       String   @default("draft") // draft | submitted | approved

  // Step 1 — Business Info
  companyName  String?
  businessType String?
  industry     String?
  gst          String?
  country      String?
  state        String?
  city         String?
  website      String?
  linkedin     String?
  instagram    String?
  whatsapp     String?
  contactName  String?
  email        String?
  phone        String?

  // Profile extras
  logoUrl      String?
  coverUrl     String?
  description  String?

  // Step 2 — Categories (stored as array)
  categories   String[]

  // Step 3 — Products
  products     PortalProduct[]

  // Step 4 — Documents
  documents    PortalDocument[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([supplierCode])
}

model PortalProduct {
  id          String         @id @default(cuid())
  portalId    String
  portal      SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name        String
  category    String
  moq         String?
  priceRange  String?
  description String?
  images      String[]
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([portalId])
}

model PortalDocument {
  id        String         @id @default(cuid())
  portalId  String
  portal    SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  docType   String         // logo | cover | license | gst | catalog | certificate
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime       @default(now())

  @@index([portalId])
}
