// SupplyBase — B2B Wholesale CRM & Supplier Management Platform

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPLIER
  BUYER
  FREELANCER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier   Supplier?
  buyer      Buyer?
  freelancer Freelancer?

  ownedSupplyChains       SupplyChain[]          @relation("SupplyChainOwner")
  buyerSupplyChains       SupplyChain[]          @relation("SupplyChainBuyer")
  supplierSupplyChains    SupplyChain[]          @relation("SupplyChainSupplier")
  milestoneParticipations MilestoneParticipant[]
  uploadedMedia           MilestoneMedia[]
  uploadedAttachments     MilestoneAttachment[]
  milestoneComments       MilestoneComment[]
  milestoneActivities     MilestoneActivity[]
  sharesReceived          SupplyChainShare[]     @relation("SharedWithUser")
  sharesGiven             SupplyChainShare[]     @relation("SharedByUser")
  notifications           Notification[]

  assignedProjects  Project[]        @relation("ProjectFreelancer")
  createdProjects   Project[]        @relation("ProjectCreatedBy")
  receivedProposals Proposal[]       @relation("ProposalFreelancer")
  sentProposals     Proposal[]       @relation("ProposalCreatedBy")
  assignedTasks     FreelancerTask[] @relation("TaskFreelancer")

  contentItems ContentItem[]
  catalogs     Catalog[]

  ownedInvoices        Invoice[]        @relation("InvoiceOwner")
  counterpartyInvoices Invoice[]        @relation("InvoiceCounterparty")
  paymentsRecorded     Payment[]        @relation("PaymentCreatedBy")
  invoiceActivity      InvoiceActivity[]
  invoiceCounters      InvoiceCounter[]

  ownedExpenses           Expense[]                @relation("ExpenseOwner")
  expenseParty            Expense[]                @relation("ExpenseParty")
  expenseCustomCategories ExpenseCustomCategory[]   @relation("ExpenseCustomCategoryOwner")

  @@index([email])
}

model Supplier {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  city        String?
  country     String?
  description String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Buyer {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  city        String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Standalone supplier directory listing — not tied to auth
model SupplierListing {
  id              String   @id @default(cuid())
  companyName     String
  description     String   @default("")
  industry        String
  supplierType    String
  country         String
  city            String
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)
  products        String[]
  responseTime    String?
  minimumOrder    String?
  phone           String?
  email           String?
  website         String?
  whatsapp        String?
  linkedin        String?
  initials        String   @default("")
  logoColor       String   @default("#6366F1")
  yearEstablished Int?
  employees       String?
  notes           String?
  savedCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogProducts Product[]
  conversation    Conversation?

  @@index([country])
  @@index([industry])
  @@index([verified])
}

// Global Product catalog for the Shop page
model Product {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  name           String
  description    String?
  moq            String?
  priceRange     String?
  category       String?
  material       String?
  specifications String?
  country        String?
  leadTime       String?
  images         String[]
  savedCount     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
  @@index([country])
}

// Auto-incrementing sequence for SB-XXXXXX supplier IDs
model SupplierIdSequence {
  id Int @id @default(autoincrement())
}

// Supplier self-onboarding portal
model SupplierPortal {
  id           String  @id @default(cuid())
  supplierCode String? @unique // SB-000001
  status       String  @default("draft") // draft | submitted | approved

  // Step 1 — Business Info
  companyName  String?
  businessType String?
  industry     String?
  gst          String?
  country      String?
  state        String?
  city         String?
  website      String?
  linkedin     String?
  instagram    String?
  whatsapp     String?
  contactName  String?
  email        String?
  phone        String?

  // Profile extras
  logoUrl     String?
  coverUrl    String?
  description String?

  // Step 2 — Categories (stored as array)
  categories String[]

  // Step 3 — Products
  products PortalProduct[]

  // Step 4 — Documents
  documents PortalDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierCode])
}

model PortalProduct {
  id          String         @id @default(cuid())
  portalId    String
  portal      SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name        String
  category    String
  moq         String?
  priceRange  String?
  description String?
  images      String[]
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([portalId])
}

model PortalDocument {
  id        String         @id @default(cuid())
  portalId  String
  portal    SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  docType   String // logo | cover | license | gst | catalog | certificate
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime       @default(now())

  @@index([portalId])
}

// CRM Models for WhatsApp Module
model Conversation {
  id            String          @id @default(cuid())
  supplierId    String          @unique
  supplier      SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unreadCount   Int             @default(0)
  pinned        Boolean         @default(false)
  archived      Boolean         @default(false)
  assigned      Boolean         @default(false)
  highPriority  Boolean         @default(false)
  lastMessageAt DateTime        @default(now())
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  messages   Message[]
  notes      CrmNote[]
  tasks      Task[]
  activities Activity[]

  @@index([supplierId])
  @@index([lastMessageAt])
}

enum MessageType {
  TEXT
  IMAGE
  PDF
  PRODUCT
  QUOTATION
  VOICE
  LOCATION
  SUPPLY_CHAIN
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String // 'user' or 'supplier'
  type           MessageType  @default(TEXT)
  content        String?
  attachmentUrl  String?
  productId      String?
  supplyChainId  String?
  supplyChain    SupplyChain? @relation(fields: [supplyChainId], references: [id], onDelete: SetNull)
  status         String       @default("sent") // sent, delivered, seen
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([supplyChainId])
}

model CrmNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  author         String       @default("Me")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model Task {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  dueDate        DateTime?
  priority       String       @default("Medium") // Low, Medium, High
  assignedTo     String       @default("Me")
  completed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model Activity {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  type           String       @default("System") // Message, Quote, Call, Meeting, System
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Supply Chain — collaborative order-lifecycle workspace (Buyer + Supplier
// portals). Real, DB-backed — no mock data. Permissions are resolved from
// ownerId + SupplyChainShare rows (see lib/supply-chain-permissions.ts).
// ---------------------------------------------------------------------------

enum SupplyChainStatus {
  ACTIVE
  DELAYED
  COMPLETED
  IN_PROGRESS
}

enum SupplyChainPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  DELAYED
}

enum BoardColumn {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum ParticipantKind {
  ASSIGNEE
  TAG
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ShareRole {
  TEAM_EDIT
  TEAM_VIEW
  BUYER_VIEW
  BUYER_COMMENT
  SUPPLIER_VIEW
  SUPPLIER_UPDATE
}

enum NotificationType {
  MILESTONE_CREATED
  ASSIGNMENT
  DUE_DATE_APPROACHING
  COMMENT_ADDED
  SUPPLY_CHAIN_SHARED
  MILESTONE_COMPLETED
  PROPOSAL_RECEIVED
  PROJECT_ASSIGNED
  ADMIN_MESSAGE
}

model SupplyChain {
  id               String              @id @default(cuid())
  name             String
  orderName        String
  orderNumber      String
  description      String?
  priority         SupplyChainPriority @default(MEDIUM)
  status           SupplyChainStatus   @default(ACTIVE)
  expectedDelivery DateTime

  ownerId String
  owner   User   @relation("SupplyChainOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  buyerUserId String?
  buyerUser   User?   @relation("SupplyChainBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerName   String

  supplierUserId String?
  supplierUser   User?   @relation("SupplyChainSupplier", fields: [supplierUserId], references: [id], onDelete: SetNull)
  supplierName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  shares     SupplyChainShare[]
  messages   Message[]

  // Optional link from a Freelancer Portal Project (see Project.supplyChainId
  // below) — purely additive, does not affect any existing Supply Chain query.
  linkedProjects Project[]

  @@index([ownerId])
  @@index([buyerUserId])
  @@index([supplierUserId])
}

model Milestone {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      MilestoneStatus     @default(NOT_STARTED)
  boardColumn BoardColumn         @default(PLANNING)
  priority    SupplyChainPriority @default(MEDIUM)
  dueDate     DateTime
  progress    Int                 @default(0)
  notes       String?
  order       Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MilestoneParticipant[]
  media        MilestoneMedia[]
  attachments  MilestoneAttachment[]
  comments     MilestoneComment[]
  activities   MilestoneActivity[]

  @@index([supplyChainId])
}

model MilestoneParticipant {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ParticipantKind
  createdAt   DateTime        @default(now())

  @@unique([milestoneId, userId, kind])
  @@index([milestoneId])
  @@index([userId])
}

model MilestoneMedia {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  kind         MediaKind
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneAttachment {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneComment {
  id              String             @id @default(cuid())
  milestoneId     String
  milestone       Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String
  parentCommentId String?
  parentComment   MilestoneComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         MilestoneComment[] @relation("CommentReplies")
  edited          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([milestoneId])
}

model MilestoneActivity {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  type        String
  description String
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([milestoneId])
}

model SupplyChainShare {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)
  role          ShareRole
  sharedById    String
  sharedBy      User        @relation("SharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([supplyChainId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}

// ─── Freelancer Portal ──────────────────────────────────────────────────

enum FreelancerAvailability {
  AVAILABLE
  BUSY
  UNAVAILABLE
}

enum FreelancerStatus {
  ACTIVE
  DEACTIVATED
}

enum PaymentStatus {
  PAID
  PENDING
  OVERDUE
}

enum ProposalStatus {
  SENT
  VIEWED
  ACCEPTED
  DECLINED
}

enum ProposalChannel {
  EMAIL
  WHATSAPP
  BOTH
}

enum ProjectStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Freelancer {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  location String?
  phone    String?
  bio      String?
  skills   String[] @default([])

  linkedinUrl  String?
  instagramUrl String?
  behanceUrl   String?
  dribbbleUrl  String?
  githubUrl    String?

  resumeFileName String?
  resumeDataUrl  String? @db.Text

  availability     FreelancerAvailability @default(AVAILABLE)
  status           FreelancerStatus       @default(ACTIVE)
  paymentStatus    PaymentStatus          @default(PENDING)
  performanceScore Int                    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  portfolioItems FreelancerPortfolioItem[]
  experience     FreelancerExperience[]

  @@index([userId])
}

model FreelancerPortfolioItem {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  caption      String?
  dataUrl      String     @db.Text
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([freelancerId])
}

model FreelancerExperience {
  id           String     @id @default(cuid())
  freelancerId String
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  role         String
  company      String
  startDate    DateTime
  endDate      DateTime?
  description  String?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([freelancerId])
}

model Proposal {
  id String @id @default(cuid())

  freelancerUserId String
  freelancer       User   @relation("ProposalFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ProposalCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  title       String
  clientName  String
  description String?
  channel     ProposalChannel
  status      ProposalStatus  @default(SENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerUserId])
}

model Project {
  id String @id @default(cuid())

  name            String
  clientName      String
  startDate       DateTime
  expectedEndDate DateTime
  priority        ProjectPriority @default(MEDIUM)
  description     String?
  status          ProjectStatus   @default(UPCOMING)
  isDraft         Boolean         @default(false)

  // Section 1 — Project Details
  city           String?
  pointOfContact String?
  whatsapp       String?
  email          String?
  linkedinUrl    String?
  notes          String? @db.Text

  // Section 6 — optional link to an existing Supply Chain. SetNull so
  // deleting a chain never cascades into (or is blocked by) a Project.
  supplyChainId String?
  supplyChain   SupplyChain? @relation(fields: [supplyChainId], references: [id], onDelete: SetNull)

  freelancerUserId String
  freelancer       User   @relation("ProjectFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks           FreelancerTask[]
  timeline        ProjectTimelineEntry[]
  referenceLinks  ProjectReferenceLink[]
  referenceImages ProjectReferenceImage[]
  documents       ProjectDocument[]
  items           ProjectItem[]

  @@index([freelancerUserId])
  @@index([supplyChainId])
}

enum ProjectTimelineStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model ProjectTimelineEntry {
  id          String                @id @default(cuid())
  projectId   String
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime
  status      ProjectTimelineStatus @default(NOT_STARTED)
  order       Int                   @default(0)
  createdAt   DateTime              @default(now())

  @@index([projectId])
}

enum ReferenceLinkPlatform {
  WEBSITE
  INSTAGRAM
  LINKEDIN
  BEHANCE
  DRIBBBLE
  GOOGLE_DRIVE
  FIGMA
}

model ProjectReferenceLink {
  id        String                @id @default(cuid())
  projectId String
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  platform  ReferenceLinkPlatform @default(WEBSITE)
  url       String
  order     Int                   @default(0)
  createdAt DateTime              @default(now())

  @@index([projectId])
}

model ProjectReferenceImage {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  caption   String?
  dataUrl   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectDocument {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String   @db.Text
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ProjectItem {
  id String @id @default(cuid())

  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category       String
  name           String
  quantity       Int      @default(1)
  sizes          String[] @default([])
  priceBeforeGst Float    @default(0)
  priceAfterGst  Float    @default(0)
  shippingCost   Float    @default(0)
  miscCost       Float    @default(0)
  leadTime       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())

  @@index([projectId])
}

model FreelancerTask {
  id String @id @default(cuid())

  title    String
  dueDate  DateTime
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(NOT_STARTED)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  freelancerUserId String
  freelancer       User   @relation("TaskFreelancer", fields: [freelancerUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([freelancerUserId])
}

// ─── Module 1: Content Management ──────────────────────────────────────────
// Owned per-user across all four portals — real, DB-backed, no mock data.

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// AI Content Studio — Phase 1. All optional/nullable since plain content
// items (created before this migration, or without going through the AI
// flow) never populate them.
enum ContentType {
  PRODUCT_DESCRIPTION
  COMPANY_PROFILE
  EMAIL
  NEWSLETTER
  LINKEDIN_POST
  INSTAGRAM_CAPTION
  WEBSITE_CONTENT
  BLOG
  CATALOG_DESCRIPTION
  OTHER
}

enum ContentLanguage {
  ENGLISH
  FRENCH
  GERMAN
}

enum ContentTone {
  PROFESSIONAL
  FRIENDLY
  LUXURY
  TECHNICAL
  MARKETING
}

enum ContentAudience {
  BUYERS
  SUPPLIERS
  EXPORTERS
  RETAILERS
  MANUFACTURERS
}

model ContentItem {
  id               String        @id @default(cuid())
  title            String
  category         String?
  tags             String[]      @default([])
  featuredImageUrl String?       @db.Text
  bodyHtml         String        @db.Text
  status           ContentStatus @default(DRAFT)

  // AI Content Studio — the prompt/config used to generate this content, and
  // whether the user has explicitly saved it as a reusable template.
  prompt      String?          @db.Text
  contentType ContentType?
  language    ContentLanguage?
  tone        ContentTone?
  audience    ContentAudience?
  isTemplate  Boolean          @default(false)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  attachments ContentAttachment[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([ownerId])
  @@index([status])
  @@index([isTemplate])
}

model ContentAttachment {
  id        String      @id @default(cuid())
  contentId String
  content   ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([contentId])
}

// ─── Module 2: Catalog Management ──────────────────────────────────────────
// One catalog per user (auto-created on first visit), Notion/Airtable-style
// editable rows.

model Catalog {
  id          String  @id @default(cuid())
  name        String  @default("My Catalog")
  description String?

  ownerId String @unique
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  rows CatalogRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum CatalogRowStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model CatalogRow {
  id String @id @default(cuid())

  catalogId String
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)

  category       String? // "Product Category" in the UI
  productName    String
  brandName      String?
  sku            String?
  description    String?
  quantity       Int              @default(0)
  sizes          String[]         @default([])
  color          String?
  moq            Int?
  hsnCode        String?
  // GST/tax rate, constrained to 0/5/12/18 at the UI+Zod layer (see
  // lib/catalog-ui.ts GST_RATE_OPTIONS). priceAfterGst is server-derived
  // from priceBeforeGst * (1 + gstPercent/100) — never hand-edited.
  gstPercent     Float            @default(0)
  priceBeforeGst Float            @default(0)
  priceAfterGst  Float            @default(0)
  currency       String           @default("INR")
  shippingCost   Float            @default(0)
  miscCost       Float            @default(0)
  leadTime       String?
  status         CatalogRowStatus @default(ACTIVE)
  notes          String?
  order          Int              @default(0)

  images      CatalogRowImage[]
  attachments CatalogRowAttachment[]
  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([catalogId])
}

model CatalogRowImage {
  id      String     @id @default(cuid())
  rowId   String
  row     CatalogRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  dataUrl String     @db.Text
  order   Int        @default(0)

  @@index([rowId])
}

model CatalogRowAttachment {
  id        String     @id @default(cuid())
  rowId     String
  row       CatalogRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String     @db.Text
  createdAt DateTime   @default(now())

  @@index([rowId])
}

// ─── Module 3: Invoice Management ──────────────────────────────────────────
// Normalized Sales/Purchase invoice engine shared across all 4 portals.
// Party/company details are snapshotted onto the Invoice at creation time
// and never re-read live from User/Buyer/Supplier afterward (see
// lib/invoicing/). All money fields are Decimal — see lib/invoicing/calc.ts
// for the shared client+server calculation engine.

// SALES/PURCHASE remain the underlying symbol names for the original two
// document types (avoids a large cosmetic rename across every call site
// that branches on `type === "SALES"`) — their user-facing label is "Tax
// Invoice"/"Purchase Invoice" (see lib/invoicing/ui.ts INVOICE_TYPE_LABELS).
// QUOTATION/CREDIT_NOTE/SALES_RETURN belong to the "sales family" (party is
// a Buyer); DEBIT_NOTE belongs to the "purchase family" (party is a
// Supplier) — see lib/invoicing/family.ts.
enum InvoiceType {
  SALES
  PURCHASE
  QUOTATION
  CREDIT_NOTE
  SALES_RETURN
  DEBIT_NOTE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  // OVERDUE intentionally removed — overdue is now derived-only (computed
  // at query/render time from dueDate + balanceDue), never stored, to
  // avoid two sources of truth. Confirmed zero rows used it before removal.

  // Quotation lifecycle
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED

  // Credit Note / Sales Return / Debit Note lifecycle
  ISSUED
  APPLIED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  UPI
  CARD
  CHEQUE
  OTHER
}

// Only relevant for CREDIT_NOTE / SALES_RETURN / DEBIT_NOTE documents.
enum InvoiceReason {
  DAMAGED_GOODS
  PRICE_ADJUSTMENT
  PRODUCT_RETURN
  BILLING_ERROR
  DISCOUNT_ADJUSTMENT
  OTHER
}

enum InvoiceTaxMode {
  EXCLUSIVE
  INCLUSIVE
}

enum InvoiceTaxBreakup {
  SINGLE
  CGST_SGST
  IGST
}

/** Shared by Shipping and each Additional Charge row — either a flat amount or a % of the taxable base. */
enum ChargeType {
  FIXED
  PERCENT
}

// Per-owner, per-type, per-year atomic sequence powering INV-2026-0001 /
// PUR-2026-0001 numbering (see lib/invoicing/numbering.ts).
model InvoiceCounter {
  id         String      @id @default(cuid())
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  type       InvoiceType
  year       Int
  lastNumber Int         @default(0)

  @@unique([ownerId, type, year])
}

model Invoice {
  id   String      @id @default(cuid())
  type InvoiceType

  // Owner = creator/controller of the invoice (seller on SALES, biller on
  // PURCHASE). Sole scoping key for lists/dashboard/KPIs.
  ownerId String
  owner   User   @relation("InvoiceOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Counterparty = the other side of the deal, a registered platform User
  // with role BUYER (SALES) or SUPPLIER (PURCHASE). Nullable — Phase 1
  // also allows a fully manual party with no matching platform account.
  counterpartyUserId String?
  counterpartyUser   User?   @relation("InvoiceCounterparty", fields: [counterpartyUserId], references: [id], onDelete: SetNull)

  invoiceNumber String
  status        InvoiceStatus @default(DRAFT)

  invoiceDate     DateTime
  dueDate         DateTime
  currency        String    @default("INR")
  paymentTerms    String?
  referenceNumber String?

  // ── Seller/company snapshot — captured at creation, editable per
  // invoice, never re-read live from the org profile afterward. ──
  sellerName    String
  sellerAddress String? @db.Text
  sellerTaxId   String?
  sellerPhone   String?
  sellerEmail   String?
  sellerLogoUrl String?

  // ── Party (Buyer on SALES / Supplier on PURCHASE) snapshot. ──
  partyName            String
  partyContactPerson   String?
  partyEmail           String?
  partyPhone           String?
  partyBillingAddress  String? @db.Text
  partyShippingAddress String? @db.Text
  partyTaxId           String?

  // Explicit tax configuration — never auto-guessed (see spec ¶11).
  taxMode    InvoiceTaxMode    @default(EXCLUSIVE)
  taxBreakup InvoiceTaxBreakup @default(SINGLE)

  // ── Totals — always server-recalculated & persisted, never trusted
  // from the client. ──
  subtotal           Decimal @db.Decimal(14, 2) @default(0)
  itemDiscountTotal  Decimal @db.Decimal(14, 2) @default(0)
  taxableAmount      Decimal @db.Decimal(14, 2) @default(0)
  cgstTotal          Decimal @db.Decimal(14, 2) @default(0)
  sgstTotal          Decimal @db.Decimal(14, 2) @default(0)
  igstTotal          Decimal @db.Decimal(14, 2) @default(0)
  taxTotal           Decimal @db.Decimal(14, 2) @default(0)

  // Shipping — either a flat amount or a % of the taxable base.
  // shippingCharge is always the server-recalculated *computed* amount
  // (existing field, unchanged); shippingType/shippingValue record how it
  // was entered so the editor/preview can round-trip "5%" rather than just
  // a flat number. Rows saved before this feature default to
  // FIXED/0 — see lib/invoicing/calc.ts's legacy fallback.
  shippingType   ChargeType @default(FIXED)
  shippingValue  Decimal    @db.Decimal(10, 2) @default(0)
  shippingCharge Decimal    @db.Decimal(14, 2) @default(0)

  // Deprecated single-row "misc charge" — kept for historical rows only.
  // New saves use the additionalCharges relation instead; never written by
  // current code, but never dropped so old invoices keep rendering as-is.
  miscCharge      Decimal @db.Decimal(14, 2) @default(0)
  miscChargeLabel String?

  additionalCharges InvoiceAdditionalCharge[]

  additionalDiscount Decimal @db.Decimal(14, 2) @default(0)
  roundOff           Decimal @db.Decimal(6, 2)  @default(0)
  grandTotal         Decimal @db.Decimal(14, 2) @default(0)

  customerNotes      String? @db.Text
  termsAndConditions String? @db.Text

  // ── Banking details — optional, shown only when at least one field is
  // set. No organization-level banking profile exists yet, so these are
  // captured per-invoice, same pattern as the seller snapshot fields above. ──
  bankAccountHolder       String?
  bankName                String?
  bankAccountNumber       String?
  bankIfscCode            String?
  bankBranch              String?
  bankUpiId               String?
  bankPaymentInstructions String? @db.Text

  // Only set on CREDIT_NOTE / SALES_RETURN / DEBIT_NOTE documents.
  reason InvoiceReason?

  // Generic "derived from" lineage — powers Quotation→Tax Invoice
  // conversion, Credit Note / Sales Return (source = the original Sales
  // invoice), and Debit Note (source = the original Purchase invoice).
  // SetNull so archiving/editing a source document never blocks or
  // corrupts a document derived from it.
  sourceInvoiceId  String?
  sourceInvoice    Invoice?  @relation("InvoiceSource", fields: [sourceInvoiceId], references: [id], onDelete: SetNull)
  derivedDocuments Invoice[] @relation("InvoiceSource")

  // Soft-hide from default lists — distinct from the CANCELLED business
  // status, which stays visible.
  archivedAt DateTime?

  items    InvoiceItem[]
  expenses Expense[]
  payments Payment[]
  activity InvoiceActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, type, invoiceNumber])
  @@index([ownerId])
  @@index([counterpartyUserId])
  @@index([status])
  @@index([type])
  @@index([invoiceDate])
  @@index([sourceInvoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String
  invoice         Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(14, 2)
  paymentDate     DateTime
  method          PaymentMethod
  referenceNumber String?
  notes           String?       @db.Text
  createdById     String
  createdBy       User          @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@index([invoiceId])
  @@index([createdById])
}

model InvoiceActivity {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  type        String // "CREATED" | "UPDATED" | "STATUS_CHANGED" | "PAYMENT_RECORDED" | "CONVERTED" | "CREDIT_NOTE_CREATED" | "SALES_RETURN_CREATED" | "DEBIT_NOTE_CREATED"
  description String
  actorId     String?
  actor       User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // Optional link back to the seller's own CatalogRow this line was
  // prefilled from (Sales invoices only). SetNull so editing/deleting a
  // CatalogRow later never blocks or corrupts historical invoice items.
  catalogRowId String?
  catalogRow   CatalogRow? @relation(fields: [catalogRowId], references: [id], onDelete: SetNull)

  productName     String
  description     String? @db.Text
  hsnSac          String?
  quantity        Decimal @db.Decimal(12, 3) @default(1)
  unit            String  @default("pcs")
  rate            Decimal @db.Decimal(14, 4) @default(0)
  discountPercent Decimal @db.Decimal(6, 3)  @default(0)
  discountAmount  Decimal @db.Decimal(14, 2) @default(0)
  taxPercent      Decimal @db.Decimal(6, 3)  @default(0)
  taxAmount       Decimal @db.Decimal(14, 2) @default(0)
  lineTotal       Decimal @db.Decimal(14, 2) @default(0)

  order Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@index([catalogRowId])
}

/** One row per "Additional Charge" (Packaging, Handling, Insurance, ...) —
 * unlike the single legacy miscCharge field, an invoice can have any
 * number of these, each independently Fixed or Percent. */
model InvoiceAdditionalCharge {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  name   String
  type   ChargeType
  value  Decimal    @db.Decimal(10, 2) @default(0) // as entered — a flat amount or a percent
  amount Decimal    @db.Decimal(14, 2) @default(0) // server-recalculated computed amount

  order Int @default(0)

  @@index([invoiceId])
}

// ─── Expenses ───────────────────────────────────────────────────────────
// Deliberately separate from InvoiceItem — expenses are operational costs
// (shipping, travel, samples, ...), not sales/purchase line items, and are
// never mixed into an Invoice's item table.

enum ExpenseCategory {
  SHIPPING
  TRAVEL
  PACKAGING
  TRANSPORTATION
  SAMPLES
  MARKETING
  FREELANCER
  OFFICE
  MISCELLANEOUS
  OTHER
}

/** User-created categories beyond the fixed system set — deliberately a
 * table, not an enum edit, so adding one never needs a schema change.
 * An Expense using a custom category still stores category=OTHER (so any
 * code only aware of the enum keeps working) plus a link here for the
 * real name/identity. */
model ExpenseCustomCategory {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("ExpenseCustomCategoryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name String

  expenses  Expense[]
  createdAt DateTime  @default(now())

  @@unique([ownerId, name])
  @@index([ownerId])
}

model Expense {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation("ExpenseOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  // Combined date+time — split into two inputs client-side, stored as one.
  occurredAt DateTime
  location   String?
  // Set only when "Pin My Location" resolved real GPS coordinates — the
  // editable `location` label above is always the source of truth for
  // display; these are additional, optional precision data.
  locationLat         Float?
  locationLng         Float?
  category            ExpenseCategory @default(MISCELLANEOUS)
  customCategoryLabel String? // used when category == OTHER

  // Set only when the user picked a saved custom category (see
  // ExpenseCustomCategory above) rather than typing a one-off OTHER label.
  // customCategoryLabel is still populated in that case too (kept in sync
  // at save time) so existing display code needs no changes.
  customCategoryId String?
  customCategory   ExpenseCustomCategory? @relation(fields: [customCategoryId], references: [id], onDelete: SetNull)

  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR")
  notes    String? @db.Text

  // Optional Buyer/Supplier this expense relates to — reuses the existing
  // platform-account directory, same as an Invoice's party.
  partyUserId String?
  partyUser   User?   @relation("ExpenseParty", fields: [partyUserId], references: [id], onDelete: SetNull)

  // Optional related Sales/Purchase document.
  relatedInvoiceId String?
  relatedInvoice   Invoice? @relation(fields: [relatedInvoiceId], references: [id], onDelete: SetNull)

  // File reference, not a base64 blob — reuses the existing filesystem
  // upload endpoint (app/api/supplier-portal/upload) which returns a
  // /uploads/portal/<file> URL. Deliberately different from the
  // dataUrl-in-DB pattern used elsewhere (Catalog/Content/SupplyChain
  // attachments), per explicit instruction to avoid storing large blobs
  // in Postgres for Expense attachments.
  attachmentFileName String?
  attachmentUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([occurredAt])
  @@index([relatedInvoiceId])
}
