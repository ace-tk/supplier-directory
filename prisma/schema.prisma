// SupplyBase — B2B Wholesale CRM & Supplier Management Platform

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPPLIER
  BUYER
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(BUYER)
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplier Supplier?
  buyer    Buyer?

  ownedSupplyChains       SupplyChain[]          @relation("SupplyChainOwner")
  buyerSupplyChains       SupplyChain[]          @relation("SupplyChainBuyer")
  supplierSupplyChains    SupplyChain[]          @relation("SupplyChainSupplier")
  milestoneParticipations MilestoneParticipant[]
  uploadedMedia           MilestoneMedia[]
  uploadedAttachments     MilestoneAttachment[]
  milestoneComments       MilestoneComment[]
  milestoneActivities     MilestoneActivity[]
  sharesReceived          SupplyChainShare[]     @relation("SharedWithUser")
  sharesGiven             SupplyChainShare[]     @relation("SharedByUser")
  notifications           Notification[]

  @@index([email])
}

model Supplier {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String
  city        String?
  country     String?
  description String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Buyer {
  id          String  @id @default(cuid())
  userId      String  @unique
  companyName String
  city        String?
  country     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Standalone supplier directory listing — not tied to auth
model SupplierListing {
  id              String   @id @default(cuid())
  companyName     String
  description     String   @default("")
  industry        String
  supplierType    String
  country         String
  city            String
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  verified        Boolean  @default(false)
  products        String[]
  responseTime    String?
  minimumOrder    String?
  phone           String?
  email           String?
  website         String?
  whatsapp        String?
  linkedin        String?
  initials        String   @default("")
  logoColor       String   @default("#6366F1")
  yearEstablished Int?
  employees       String?
  notes           String?
  savedCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  catalogProducts Product[]
  conversation    Conversation?

  @@index([country])
  @@index([industry])
  @@index([verified])
}

// Global Product catalog for the Shop page
model Product {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  
  name           String
  description    String?
  moq            String?
  priceRange     String?
  category       String?
  material       String?
  specifications String?
  country        String?
  leadTime       String?
  images         String[]
  savedCount     Int             @default(0)
  
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  
  @@index([supplierId])
  @@index([category])
  @@index([country])
}

// Auto-incrementing sequence for SB-XXXXXX supplier IDs
model SupplierIdSequence {
  id Int @id @default(autoincrement())
}

// Supplier self-onboarding portal
model SupplierPortal {
  id           String   @id @default(cuid())
  supplierCode String?  @unique  // SB-000001
  status       String   @default("draft") // draft | submitted | approved

  // Step 1 — Business Info
  companyName  String?
  businessType String?
  industry     String?
  gst          String?
  country      String?
  state        String?
  city         String?
  website      String?
  linkedin     String?
  instagram    String?
  whatsapp     String?
  contactName  String?
  email        String?
  phone        String?

  // Profile extras
  logoUrl      String?
  coverUrl     String?
  description  String?

  // Step 2 — Categories (stored as array)
  categories   String[]

  // Step 3 — Products
  products     PortalProduct[]

  // Step 4 — Documents
  documents    PortalDocument[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([supplierCode])
}

model PortalProduct {
  id          String         @id @default(cuid())
  portalId    String
  portal      SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  name        String
  category    String
  moq         String?
  priceRange  String?
  description String?
  images      String[]
  sortOrder   Int            @default(0)
  createdAt   DateTime       @default(now())

  @@index([portalId])
}

model PortalDocument {
  id        String         @id @default(cuid())
  portalId  String
  portal    SupplierPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
  docType   String         // logo | cover | license | gst | catalog | certificate
  fileName  String
  fileUrl   String
  fileSize  Int?
  createdAt DateTime       @default(now())

  @@index([portalId])
}

// CRM Models for WhatsApp Module
model Conversation {
  id              String   @id @default(cuid())
  supplierId      String   @unique
  supplier        SupplierListing @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  unreadCount     Int      @default(0)
  pinned          Boolean  @default(false)
  archived        Boolean  @default(false)
  assigned        Boolean  @default(false)
  highPriority    Boolean  @default(false)
  lastMessageAt   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  messages        Message[]
  notes           CrmNote[]
  tasks           Task[]
  activities      Activity[]

  @@index([supplierId])
  @@index([lastMessageAt])
}

enum MessageType {
  TEXT
  IMAGE
  PDF
  PRODUCT
  QUOTATION
  VOICE
  LOCATION
  SUPPLY_CHAIN
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          String   // 'user' or 'supplier'
  type            MessageType @default(TEXT)
  content         String?
  attachmentUrl   String?
  productId       String?
  supplyChainId   String?
  supplyChain     SupplyChain? @relation(fields: [supplyChainId], references: [id], onDelete: SetNull)
  status          String   @default("sent") // sent, delivered, seen
  createdAt       DateTime @default(now())

  @@index([conversationId])
  @@index([supplyChainId])
}

model CrmNote {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content         String
  author          String   @default("Me")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
}

model Task {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title           String
  dueDate         DateTime?
  priority        String   @default("Medium") // Low, Medium, High
  assignedTo      String   @default("Me")
  completed       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([conversationId])
}

model Activity {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  type            String   @default("System") // Message, Quote, Call, Meeting, System
  createdAt       DateTime @default(now())

  @@index([conversationId])
}

// ---------------------------------------------------------------------------
// Supply Chain — collaborative order-lifecycle workspace (Buyer + Supplier
// portals). Real, DB-backed — no mock data. Permissions are resolved from
// ownerId + SupplyChainShare rows (see lib/supply-chain-permissions.ts).
// ---------------------------------------------------------------------------

enum SupplyChainStatus {
  ACTIVE
  DELAYED
  COMPLETED
  IN_PROGRESS
}

enum SupplyChainPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING
  COMPLETED
  DELAYED
}

enum BoardColumn {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
}

enum ParticipantKind {
  ASSIGNEE
  TAG
}

enum MediaKind {
  IMAGE
  VIDEO
}

enum ShareRole {
  TEAM_EDIT
  TEAM_VIEW
  BUYER_VIEW
  BUYER_COMMENT
  SUPPLIER_VIEW
  SUPPLIER_UPDATE
}

enum NotificationType {
  MILESTONE_CREATED
  ASSIGNMENT
  DUE_DATE_APPROACHING
  COMMENT_ADDED
  SUPPLY_CHAIN_SHARED
  MILESTONE_COMPLETED
}

model SupplyChain {
  id               String              @id @default(cuid())
  name             String
  orderName        String
  orderNumber      String
  description      String?
  priority         SupplyChainPriority @default(MEDIUM)
  status           SupplyChainStatus   @default(ACTIVE)
  expectedDelivery DateTime

  ownerId String
  owner   User   @relation("SupplyChainOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  buyerUserId String?
  buyerUser   User?   @relation("SupplyChainBuyer", fields: [buyerUserId], references: [id], onDelete: SetNull)
  buyerName   String

  supplierUserId String?
  supplierUser   User?  @relation("SupplyChainSupplier", fields: [supplierUserId], references: [id], onDelete: SetNull)
  supplierName   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  milestones Milestone[]
  shares     SupplyChainShare[]
  messages   Message[]

  @@index([ownerId])
  @@index([buyerUserId])
  @@index([supplierUserId])
}

model Milestone {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      MilestoneStatus     @default(NOT_STARTED)
  boardColumn BoardColumn         @default(PLANNING)
  priority    SupplyChainPriority @default(MEDIUM)
  dueDate     DateTime
  progress    Int                 @default(0)
  notes       String?
  order       Int                 @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MilestoneParticipant[]
  media        MilestoneMedia[]
  attachments  MilestoneAttachment[]
  comments     MilestoneComment[]
  activities   MilestoneActivity[]

  @@index([supplyChainId])
}

model MilestoneParticipant {
  id          String          @id @default(cuid())
  milestoneId String
  milestone   Milestone       @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        ParticipantKind
  createdAt   DateTime        @default(now())

  @@unique([milestoneId, userId, kind])
  @@index([milestoneId])
  @@index([userId])
}

model MilestoneMedia {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  kind         MediaKind
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneAttachment {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  dataUrl      String    @db.Text
  uploadedById String
  uploadedBy   User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
}

model MilestoneComment {
  id              String             @id @default(cuid())
  milestoneId     String
  milestone       Milestone          @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  authorId        String
  author          User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  content         String
  parentCommentId String?
  parentComment   MilestoneComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         MilestoneComment[] @relation("CommentReplies")
  edited          Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([milestoneId])
}

model MilestoneActivity {
  id          String    @id @default(cuid())
  milestoneId String
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  type        String
  description String
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())

  @@index([milestoneId])
}

model SupplyChainShare {
  id            String      @id @default(cuid())
  supplyChainId String
  supplyChain   SupplyChain @relation(fields: [supplyChainId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation("SharedWithUser", fields: [userId], references: [id], onDelete: Cascade)
  role          ShareRole
  sharedById    String
  sharedBy      User        @relation("SharedByUser", fields: [sharedById], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([supplyChainId, userId])
  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
}
